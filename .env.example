# Upstream deco.cx storefront MCP endpoint
MCP_ENDPOINT=https://mystore.deco.site/mcp

# Display name used in widget and server logs
STORE_NAME=My Store

# (Optional) Widget accent color — used for buttons and highlights
VITE_WIDGET_ACCENT_COLOR=#000000

# (Optional) Widget logo URL
VITE_WIDGET_LOGO_URL=

# Server port (default: 3000)
PORT=3000

# (Optional) Extra image CDN domains allowed by the widget CSP, comma-separated.
# Add any store-specific CDN origins here so product images load correctly.
# Common examples:
#   Shopify (already included by default): https://cdn.shopify.com
#   VTEX storefronts: https://YOURSTOREID.vtexassets.com,https://YOURSTOREID.vteximg.com.br
#   Wake Commerce: https://YOURSTOREID.wakecommerce.com.br
# Leave blank to use the built-in defaults only.
WIDGET_IMAGE_DOMAINS=
